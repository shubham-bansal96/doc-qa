# Required for the "query" command (LLM answer generation)
ANTHROPIC_AUTH_TOKEN=your-anthropic-api-key-here

# Optional: Custom Anthropic API endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Anthropic model for answer generation
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Qdrant vector database URL
# QDRANT_URL=http://localhost:6333

# Optional: Ollama server URL
# OLLAMA_URL=http://localhost:11434

# Optional: Ollama embedding model
# EMBEDDING_MODEL=nomic-embed-text

# Optional: Ollama vision model for image processing
# VISION_MODEL=llava